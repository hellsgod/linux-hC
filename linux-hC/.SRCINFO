pkgname = linux-hC
	pkgdesc = The Linux BORE + LTO + ZEN/Cachy/Clear Tweaks + Custom set of build flags Clang built hC-kernel kernel and modules
	depends = coreutils
	depends = kmod
	depends = initramfs
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = modprobed-db: Keeps track of EVERY kernel module that has ever been probed - useful for those of us who make localmodconfig
	optdepends = scx-scheds: to use sched-ext schedulers
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	provides = KSMBD-MODULE
	provides = NTSYNC-MODULE

pkgname = linux-hC-headers
	pkgdesc = Headers and scripts for building modules for the Linux BORE + LTO + ZEN/Cachy/Clear Tweaks + Custom set of build flags Clang built hC-kernel kernel
	depends = binutils
	depends = glibc
	depends = libelf
	depends = libgcc
	depends = openssl
	depends = pahole
	depends = xxhash
	depends = zlib
	depends = zstd
	depends = linux-hC
	depends = clang
	depends = llvm
	depends = lld
	depends = pahole>=1:1.32-2
	provides = LINUX-HEADERS

pkgname = linux-hC-nvidia-open
	pkgdesc = nvidia open modules of 620.73.04 driver for the linux-hC kernel
	license = MIT AND GPL-2.0-only
	depends = linux-hC=7.3.5-1
	depends = nvidia-utils=620.73.04
	depends = libglvnd
	provides = NVIDIA-MODULE
	conflicts = linux-hC-nvidia
