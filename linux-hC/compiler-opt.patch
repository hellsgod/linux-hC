diff --git a/Makefile b/Makefile
index 7d8c4667e79f2..3cf66ef11caad 100644
--- a/Makefile
+++ b/Makefile
@@ -608,7 +608,23 @@ LINUXINCLUDE    := \
 
 KBUILD_AFLAGS   := -D__ASSEMBLY__ -fno-PIE
 
-KBUILD_CFLAGS :=
+KBUILD_CFLAGS := \
+  -mllvm -enable-load-pre -mllvm -enable-load-in-loop-pre -mllvm -enable-split-backedge-in-load-pre \
+  -mllvm -basic-aa-recphi -mllvm -basic-aa-separate-storage \
+  -mllvm -enable-gvn-memoryssa \
+  -mllvm -dse-optimize-memoryssa \
+  -mllvm -enable-dse-partial-overwrite-tracking \
+  -mllvm -enable-constraint-elimination \
+  -mllvm -aggressive-instcombine-max-scan-instrs=260 \
+  -mllvm -memdep-block-scan-limit=40 \
+  -mllvm -attributor-max-iterations=3 \
+  -mllvm -unswitch-threshold=64 -mllvm -enable-nontrivial-unswitch \
+  -mllvm -max-speculation-depth=12 \
+  -mllvm -simplifycfg-merge-cond-stores -mllvm -simplifycfg-hoist-common \
+  -mllvm -simplifycfg-hoist-cond-stores \
+  -mllvm -simplifycfg-sink-common \
+  -mllvm -branch-fold-placement -mllvm -forward-switch-cond \
+  -mllvm -hoist-const-loads -mllvm -hoist-const-stores
 KBUILD_CFLAGS += -fshort-wchar
 KBUILD_CFLAGS += -funsigned-char
 KBUILD_CFLAGS += -fno-common
@@ -935,9 +951,58 @@ endif # need-config
 
 KBUILD_CFLAGS	+= -fno-delete-null-pointer-checks
 
+# Experimental LLVM ThinLTO tuning (ld.lld is invoked directly).
+# --mllvm passes options to LLVM; do not use -plugin-opt for these.
+# These are intentionally experimental and require checking against the
+# exact LLVM 24 build. Acceptance does not establish a performance benefit.
+ifeq ($(CONFIG_LTO_CLANG_THIN),y)
+KBUILD_LDFLAGS += --lto-O3
+KBUILD_LDFLAGS += \
+  --mllvm=-inline-threshold=420 \
+  --mllvm=-inlinehint-threshold=170 \
+  --mllvm=-inlinecold-threshold=110 \
+  --mllvm=-inline-deferral \
+  --mllvm=-inline-deferral-scale=4 \
+  --mllvm=-inline-savings-multiplier=2 \
+  --mllvm=-inline-savings-profitable-multiplier=3 \
+  --mllvm=-inline-size-allowance=28 \
+  --mllvm=-max-num-inline-blocks=14 \
+  --mllvm=-max-partial-inlining=8 \
+  --mllvm=-unroll-threshold=70 \
+  --mllvm=-unroll-max-count=10 \
+  --mllvm=-unroll-max-iteration-count-to-analyze=40 \
+  --mllvm=-unroll-allow-partial \
+  --mllvm=-unroll-partial-threshold=240 \
+  --mllvm=-enable-unroll-and-jam \
+  --mllvm=-unroll-and-jam-threshold=60 \
+  --mllvm=-enable-loop-versioning-licm \
+  --mllvm=-enable-unswitch-cost-multiplier \
+  --mllvm=-gvn-add-phi-translation \
+  --mllvm=-enable-gvn-sink \
+  --mllvm=-enable-gvn-hoist \
+  --mllvm=-enable-memcpy-dag-opt \
+  --mllvm=-enable-dse-initializes-attr-improvement \
+  --mllvm=-enable-dse-partial-store-merging \
+  --mllvm=-instcombine-code-sinking \
+  --mllvm=-sink-insts-to-avoid-spills \
+  --mllvm=-adce-remove-loops \
+  --mllvm=-adce-remove-control-flow \
+  --mllvm=-hoist-common-insts \
+  --mllvm=-enable-loop-simplifycfg-term-folding \
+  --mllvm=-consthoist-with-block-frequency \
+  --mllvm=-use-noalias-intrinsic-during-inlining \
+  --mllvm=-lsr-drop-solution \
+  --mllvm=-lsr-exp-narrow \
+  --mllvm=-lsr-insns-cost \
+  --mllvm=-enable-lsr-phielim \
+  --mllvm=-loop-version-annotate-no-alias \
+  --mllvm=-hot-cold-static-analysis \
+  --mllvm=-enable-tail-merge
+endif
+
 ifdef CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE
-KBUILD_CFLAGS += -O2
-KBUILD_RUSTFLAGS += -Copt-level=2
+KBUILD_CFLAGS += -O3
+KBUILD_RUSTFLAGS += -Copt-level=3
 else ifdef CONFIG_CC_OPTIMIZE_FOR_SIZE
 KBUILD_CFLAGS += -Os
 KBUILD_RUSTFLAGS += -Copt-level=s
diff --git a/init/Kconfig b/init/Kconfig
index 4013781e0a029..1387990e777b4 100644
--- a/init/Kconfig
+++ b/init/Kconfig
@@ -1462,10 +1462,10 @@ choice
 	default CC_OPTIMIZE_FOR_PERFORMANCE
 
 config CC_OPTIMIZE_FOR_PERFORMANCE
-	bool "Optimize for performance (-O2)"
+	bool "Optimize for performance (-O3)"
 	help
 	  This is the default optimization level for the kernel, building
-	  with the "-O2" compiler flag for best performance and most
+	  with the "-O3" compiler flag for best performance and most
 	  helpful compile-time warnings.
 
 config CC_OPTIMIZE_FOR_SIZE
